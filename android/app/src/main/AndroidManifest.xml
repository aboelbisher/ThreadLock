<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer needs OpenGL ES 3.0 (every Android device from the last ~10 years). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- A light tap for each drop landing, a heavy one for mud and jams (a setting turns them off). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- enableOnBackInvokedCallback="false": Back keeps arriving as a key event in native code.
         allowBackup: Android Auto Backup saves the progress file to the player's Google account and
         restores it on a new phone or after a reinstall (rules in res/xml). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- ThreadlockActivity: Android's NativeActivity (runs the C++ game) + the native bridge.
             configChanges: we handle size changes ourselves instead of being restarted. -->
        <activity
            android:name=".ThreadlockActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">

            <!-- Which native library to load: lib<name>.so, the CMake target threadlock. -->
            <meta-data android:name="android.app.lib_name" android:value="threadlock" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The AdMob app id. This is GOOGLE'S SAMPLE APP ID (test ads only): replace it with
             Threadlock's own from the AdMob console before a release, together with the real ad
             units in threadlock_app.cpp (MakeAdsConfig). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>
</manifest>
