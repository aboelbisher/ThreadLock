<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's foreground: the junction (owner's pick B, 10 Nov 2026). A blue and an amber stream run
     in from the upper corners to one brass junction ring, one drop of each inside; the way out runs down.
     108dp canvas; the launcher shows the middle 72dp (the streams start outside it, as if from off the icon).
     Vector drawables have no blur: each stream's glow is two wider, see-through strokes under it.
     android/store/icon.svg is the same picture with real glow (the store icon). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- the junction's soft light -->
    <path android:fillColor="#1F3DA1FF" android:pathData="M54,30 a30,30 0 1 1 0,60 a30,30 0 1 1 0,-60 z" />
    <!-- blue stream: glow, glow, core -->
    <path android:strokeColor="#2E3DA1FF" android:strokeWidth="21" android:strokeLineCap="round"
        android:pathData="M22,26 C34,34 40,46 46,54" />
    <path android:strokeColor="#593DA1FF" android:strokeWidth="14" android:strokeLineCap="round"
        android:pathData="M22,26 C34,34 40,46 46,54" />
    <path android:strokeColor="#FF3DA1FF" android:strokeWidth="9" android:strokeLineCap="round"
        android:pathData="M22,26 C34,34 40,46 46,54" />
    <!-- amber stream -->
    <path android:strokeColor="#2EFFAB29" android:strokeWidth="21" android:strokeLineCap="round"
        android:pathData="M86,26 C74,34 68,46 62,54" />
    <path android:strokeColor="#59FFAB29" android:strokeWidth="14" android:strokeLineCap="round"
        android:pathData="M86,26 C74,34 68,46 62,54" />
    <path android:strokeColor="#FFFFAB29" android:strokeWidth="9" android:strokeLineCap="round"
        android:pathData="M86,26 C74,34 68,46 62,54" />
    <!-- the way out, an empty pipe -->
    <path android:strokeColor="#FF0A121A" android:strokeWidth="12" android:strokeLineCap="round"
        android:pathData="M54,72 L54,92" />
    <!-- the brass ring: dark inside, brass rim, a light line on its upper edge -->
    <path android:fillColor="#FF0A121A" android:strokeColor="#FFC9A15A" android:strokeWidth="6"
        android:pathData="M54,44 a16,16 0 1 1 0,32 a16,16 0 1 1 0,-32 z" />
    <path android:strokeColor="#99F2D08A" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M42.7,48.7 A16,16 0 0 1 65.3,48.7" />
    <!-- one drop of each colour inside, with a glow -->
    <path android:fillColor="#553DA1FF" android:pathData="M49,53 a6,6 0 1 1 0,12 a6,6 0 1 1 0,-12 z" />
    <path android:fillColor="#FF3DA1FF" android:pathData="M49,55 a4,4 0 1 1 0,8 a4,4 0 1 1 0,-8 z" />
    <path android:fillColor="#55FFAB29" android:pathData="M59,55 a6,6 0 1 1 0,12 a6,6 0 1 1 0,-12 z" />
    <path android:fillColor="#FFFFAB29" android:pathData="M59,57 a4,4 0 1 1 0,8 a4,4 0 1 1 0,-8 z" />
</vector>
